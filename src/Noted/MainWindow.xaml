<Window x:Class="Noted.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Noted"
        Height="760" Width="1120" MinHeight="360" MinWidth="520"
        WindowStyle="None"
        AllowsTransparency="False"
        AllowDrop="True"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Ui}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{DynamicResource Brush.Background}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ============ title bar / tab strip ============ -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource Brush.Background}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Noted"
                           Margin="14,0,10,0" VerticalAlignment="Center"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Faint}" />

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <ListBox x:Name="TabList"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource TabItemStyle}"
                                 SelectionChanged="OnTabSelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" />
                                        <Ellipse Width="6" Height="6" Margin="7,1,0,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource Brush.Accent}"
                                                 Visibility="{Binding IsModified,
                                                     Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource TabCloseButton}" Content="&#xE8BB;"
                                                Click="OnCloseTabClick" ToolTip="Close tab (Ctrl+W)" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Style="{StaticResource IconButton}" Content="&#xE710;"
                                Width="28" Margin="4,0,0,0" VerticalAlignment="Center"
                                Click="OnNewTabClick" ToolTip="New note (Ctrl+N)" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Content="&#xE706;"
                            Click="OnToggleThemeClick" ToolTip="Toggle theme (Ctrl+Shift+D)" />
                    <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE712;"
                            Click="OnMenuClick" ToolTip="Menu — shortcuts with F1" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimizeClick" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            Click="OnMaximizeClick" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <!-- ============ editor ============ -->
            <Grid Grid.Row="1" x:Name="EditorHost" Background="{DynamicResource Brush.Background}"
                  SizeChanged="OnEditorHostSizeChanged">
                <avalon:TextEditor x:Name="Editor"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   WordWrap="True"
                                   ShowLineNumbers="False"
                                   HorizontalScrollBarVisibility="Disabled"
                                   VerticalScrollBarVisibility="Auto"
                                   Padding="48,20,48,60"
                                   FontSize="15.5" />
            </Grid>

            <!-- ============ status bar ============ -->
            <Grid Grid.Row="2" x:Name="StatusBar" Background="{DynamicResource Brush.Surface}">
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                <DockPanel Margin="14,0">
                    <TextBlock x:Name="StatusPath" Style="{StaticResource StatusText}"
                               DockPanel.Dock="Left" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="StatusStats" Style="{StaticResource StatusText}" />
                        <TextBlock x:Name="StatusCaret" Style="{StaticResource StatusText}" />
                        <TextBlock x:Name="StatusEncoding" Style="{StaticResource StatusText}" Margin="0" />
                    </StackPanel>
                    <TextBlock />
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
